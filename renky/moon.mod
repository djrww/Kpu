name = "ky678/renky"

version = "0.1.3"

readme = "README.md"

license = "Apache-2.0"

keywords = [
  "graphics",
  "coordinate-systems",
  "finite-field",
  "tropical",
  "cohomology",
  "f-splitting",
  "p-adic",
  "class-group",
  "verified",
]

preferred_target = "wasm-gc"

description = "renky: system/graph (zero-dependency coordinate systems for rendering), system/algorithms/omniring, and system/algorithms/vlab (228 numbered linear-algebra algorithms over twelve combinable inner-product spaces, 152 self-proving tests). Axiom: a self-contained finite-field skeleton plus eight ring/semiring structures, heat (tropical) degenerations, homology, and a closed computational loop. No third-party dependencies."
