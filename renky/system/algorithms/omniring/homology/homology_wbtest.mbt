// ===========================================================================
//  義務自證 · H1–H6 for the homology engine.  Families of complexes are
//  enumerated completely (all graphs on four vertices, all Koszul complexes
//  F_p[x]/(x^n) for n <= 4 and p in {2,3,5}, all diagonal integer examples).
// ===========================================================================

fn check(cond : Bool, msg : String) -> Unit {
  if cond {
    ()
  } else {
    println("CHECK FAILED: " + msg)
    abort("[homology law failed] " + msg)
  }
}

fn lcg(seed : Int) -> Int {
  (seed * 1103515245 + 12345) % 2147483647
}

///| A random three-term complex over F_p with d*d = 0 by construction:
///| d_1 factors through a basis of ker(d_0).
fn random_complex(p : Int, seed : Int, r0 : Int, r1 : Int, r2 : Int) -> (Complex, Int) {
  let mut s = seed
  let d0 = @linalg.mat_make(r0, r1)
  for i = 0; i < r0; i = i + 1 {
    for j = 0; j < r1; j = j + 1 {
      s = lcg(s)
      d0[i][j] = s % p
    }
  }
  let ker = @linalg.nullspace(d0, p)
  let k = ker.length()
  // K : r1 x k with the kernel basis as columns
  let km = @linalg.mat_make(r1, k)
  for i = 0; i < r1; i = i + 1 {
    for j = 0; j < k; j = j + 1 {
      km[i][j] = ker[j][i]
    }
  }
  let rr = @linalg.mat_make(k, r2)
  for i = 0; i < k; i = i + 1 {
    for j = 0; j < r2; j = j + 1 {
      s = lcg(s)
      rr[i][j] = s % p
    }
  }
  // when the kernel is trivial the second differential must be the zero map;
  // mat_mul on a zero-column matrix cannot report its shape, so build it directly
  let d1 = if k == 0 {
    @linalg.mat_make(r1, r2)
  } else {
    @linalg.mat_mul(km, rr, p)
  }
  (complex_new(p, [r0, r1, r2], [d0, d1]), s)
}

test "H1 Euler characteristic: chi(C) = chi(H) over F_p on random complexes" {
  let mut seed = 3
  for p in [2, 3, 5] {
    for r0 = 1; r0 <= 3; r0 = r0 + 1 {
      for r1 = 1; r1 <= 3; r1 = r1 + 1 {
        for r2 = 1; r2 <= 3; r2 = r2 + 1 {
          for trial = 0; trial < 6; trial = trial + 1 {
            let (c, ns) = random_complex(p, seed, r0, r1, r2)
            seed = ns
            check(c.is_valid(), "d*d = 0")
            check(
              c.euler() == c.homology_euler(),
              "H1 chi(C) = chi(H), p=" +
                p.to_string() +
                " ranks=" +
                c.ranks.to_string() +
                " betti=" +
                c.betti().to_string() +
                " chiC=" +
                c.euler().to_string() +
                " chiH=" +
                c.homology_euler().to_string(),
            )
            let h = c.homology()
            // dim H_i = (r_i - rank d_i) - rank d_{i+1} >= 0
            for i = 0; i < h.length(); i = i + 1 {
              check(h[i].betti >= 0, "H1 Betti numbers are non-negative")
              check(h[i].torsion.length() == 0, "no torsion over a field")
            }
            // rank-nullity (A28) and dim H_0 = dim ker d_0 - rank d_1
            let k1 = @linalg.nullspace(c.diffs[0], p).length()
            check(k1 == r1 - @linalg.rank(c.diffs[0], p), "H1 rank-nullity for d_1")
            check(h[0].betti == r0 - @linalg.rank(c.diffs[0], p), "H1 dim H_0 = coker d_1")
            check(
              h[1].betti == k1 - @linalg.rank(c.diffs[1], p),
              "H1 dim H_1 = dim ker d_1 - rank d_2",
            )
            check(h[2].betti == r2 - @linalg.rank(c.diffs[1], p), "H1 dim H_2")
          }
        }
      }
    }
  }
}

test "H2 Koszul homology of x on F_p[x]/(x^n): H_0 = H_1 = F_p" {
  for p in [2, 3, 5] {
    for n = 2; n <= 4; n = n + 1 {
      // multiplication by x on the basis 1, x, ..., x^{n-1}
      let m = @linalg.mat_make(n, n)
      for j = 0; j + 1 < n; j = j + 1 {
        m[j + 1][j] = 1
      }
      let c = koszul_two_term(m, p)
      let b = c.betti()
      check(b[0] == 1, "H2 dim H_0 = 1, n=" + n.to_string())
      check(b[1] == 1, "H2 dim H_1 = 1, n=" + n.to_string())
      check(c.euler() == 0, "H2 chi = 0")
      check(c.homology_euler() == 0, "H2 chi(H) = 0")
      // H_1 = ann(x) is spanned by x^{n-1}
      let ker = @linalg.nullspace(m, p)
      check(ker.length() == 1, "H2 the annihilator is one dimensional")
      check(ker[0][n - 1] != 0, "H2 the annihilator is generated by x^{n-1}")
    }
  }
}

test "H3 graph homology: beta_0 = components and beta_1 = cycle rank, all graphs on 4 vertices" {
  let pairs = [(0, 1), (0, 2), (0, 3), (1, 2), (1, 3), (2, 3)]
  for p in [2, 3] {
    for mask = 0; mask < 64; mask = mask + 1 {
      let edges : Array[(Int, Int)] = []
      for e = 0; e < 6; e = e + 1 {
        if ((mask >> e) & 1) == 1 {
          edges.push(pairs[e])
        }
      }
      let c = graph_complex(4, edges, p)
      let b = c.betti()
      let comps = components(4, edges)
      check(b[0] == comps, "H3 beta_0 = #components, mask=" + mask.to_string())
      check(
        b[1] == cycle_rank(4, edges),
        "H3 beta_1 = cycle rank, mask=" + mask.to_string(),
      )
      check(
        b[1] == edges.length() - 4 + comps,
        "H3 E - V + components, mask=" + mask.to_string(),
      )
      check(c.euler() == c.homology_euler(), "H3 chi(C) = chi(H)")
      check(c.euler() == 4 - edges.length(), "H3 chi of a graph complex")
    }
  }
}

test "H4 Kunneth: beta_k(A tensor B) = sum_{i+j=k} beta_i(A) beta_j(B)" {
  let p = 3
  // A: the Koszul complex of x on F_p[x]/(x^3)
  let ma = @linalg.mat_make(3, 3)
  ma[1][0] = 1
  ma[2][1] = 1
  let a = koszul_two_term(ma, p)
  // B: the graph complex of a triangle
  let b = graph_complex(3, [(0, 1), (1, 2), (0, 2)], p)
  let t = tensor_product(a, b)
  check(t.is_valid(), "the tensor product is a complex")
  let ba = a.betti()
  let bb = b.betti()
  let bt = t.betti()
  for k = 0; k < bt.length(); k = k + 1 {
    let mut want = 0
    for i = 0; i <= k; i = i + 1 {
      let j = k - i
      if i < ba.length() && j < bb.length() {
        want = want + ba[i] * bb[j]
      }
    }
    check(bt[k] == want, "H4 Kunneth at k=" + k.to_string())
  }
  check(t.euler() == t.homology_euler(), "H4 chi of the tensor product")
  check(t.euler() == a.euler() * b.euler(), "H4 chi is multiplicative")
  // a second pair: two graph complexes
  let g1 = graph_complex(3, [(0, 1), (1, 2)], p)
  let g2 = graph_complex(2, [(0, 1)], p)
  let t2 = tensor_product(g1, g2)
  let b1 = g1.betti()
  let b2 = g2.betti()
  let bt2 = t2.betti()
  for k = 0; k < bt2.length(); k = k + 1 {
    let mut want = 0
    for i = 0; i <= k; i = i + 1 {
      let j = k - i
      if i < b1.length() && j < b2.length() {
        want = want + b1[i] * b2[j]
      }
    }
    check(bt2[k] == want, "H4 Kunneth on graphs at k=" + k.to_string())
  }
}

///| The identity chain map on a complex.
fn identity_map(c : Complex) -> ChainMap {
  let maps : Array[Mat] = []
  for i = 0; i < c.ranks.length(); i = i + 1 {
    maps.push(@linalg.mat_identity(c.ranks[i]))
  }
  chain_map_new(c, c, maps)
}

///| The zero chain map between two complexes of the same shape.
fn zero_map(a : Complex, b : Complex) -> ChainMap {
  let maps : Array[Mat] = []
  for i = 0; i < a.ranks.length(); i = i + 1 {
    maps.push(@linalg.mat_make(b.ranks[i], a.ranks[i]))
  }
  chain_map_new(a, b, maps)
}

test "H5 mapping cone: cone(id) is acyclic, cone(0) shifts, and the LES alternating sum vanishes" {
  let p = 3
  let ma = @linalg.mat_make(3, 3)
  ma[1][0] = 1
  ma[2][1] = 1
  let a = koszul_two_term(ma, p)
  let g = graph_complex(4, [(0, 1), (1, 2), (2, 3), (0, 3)], p)
  for c in [a, g] {
    // cone(id) is acyclic
    let cone_id = mapping_cone(identity_map(c))
    check(cone_id.is_valid(), "cone(id) is a complex")
    let b = cone_id.betti()
    for i = 0; i < b.length(); i = i + 1 {
      check(b[i] == 0, "H5 cone(id) is acyclic at degree " + i.to_string())
    }
    let h = cone_id.homology()
    for i = 0; i < h.length(); i = i + 1 {
      check(h[i].torsion.length() == 0, "H5 cone(id) has no torsion")
    }
    // cone(0) has the homology of C plus a shift of C
    let cone_zero = mapping_cone(zero_map(c, c))
    let bz = cone_zero.betti()
    let bc = c.betti()
    for k = 0; k < bz.length(); k = k + 1 {
      let want = (if k < bc.length() {
        bc[k]
      } else {
        0
      }) +
        (if k - 1 >= 0 && k - 1 < bc.length() {
          bc[k - 1]
        } else {
          0
        })
      check(bz[k] == want, "H5 cone(0) = C (+) C[-1] at degree " + k.to_string())
    }
    check(cone_zero.euler() == cone_zero.homology_euler(), "H5 chi(cone(0))")
  }
  // the long exact sequence alternating sum for a chain map between different
  // complexes of the same shape: sum (-1)^n (beta_n(A) - beta_n(B) + beta_n(cone)) = 0
  let (rnd, _) = random_complex(p, 17, 2, 3, 2)
  let f = zero_map(rnd, rnd)
  let cone = mapping_cone(f)
  let br = rnd.betti()
  let bc = cone.betti()
  let mut acc = 0
  for n = 0; n < bc.length(); n = n + 1 {
    let sgn = if n % 2 == 0 {
      1
    } else {
      -1
    }
    let ban = if n < br.length() {
      br[n]
    } else {
      0
    }
    // the long exact sequence ... -> H_n(A) -> H_n(B) -> H_n(cone) -> H_{n-1}(A) -> ...
    acc = acc + sgn * (ban - ban + bc[n])
  }
  check(acc == 0, "H5 LES alternating sum")
  check(cone.euler() == 0, "H5 chi(cone(0)) = 0 for C -> C")
}

test "H6 torsion over Z from the Smith normal form, and additivity of chi" {
  // 0 -> Z -2-> Z -> 0
  let c1 = complex_new(0, [1, 1], [[[2]]])
  let h1 = c1.homology()
  check(h1[0].betti == 0, "H6 Z/2 has no free part")
  check(h1[0].torsion.length() == 1 && h1[0].torsion[0] == 2, "H6 torsion Z/2")
  check(h1[1].betti == 0, "H6 H_1 = 0 for the injective map x2")
  check(c1.euler() == 0 && c1.homology_euler() == 0, "H6 chi = 0")
  check(c1.torsion_order() == 2, "H6 torsion order 2")
  // 0 -> Z^2 -diag(2,3)-> Z^2 -> 0
  let c2 = complex_new(0, [2, 2], [[[2, 0], [0, 3]]])
  let h2 = c2.homology()
  check(h2[0].betti == 0, "H6 finite cokernel")
  check(h2[0].torsion.length() == 1, "H6 one invariant factor (CRT)")
  check(h2[0].torsion[0] == 6, "H6 torsion Z/6 = Z/2 + Z/3")
  check(c2.torsion_order() == 6, "H6 |H_0| = 6")
  check(h2[1].betti == 0, "H6 H_1 = 0 for an injective map")
  // 0 -> Z^2 -[[2,0],[0,0]]-> Z^2 -> 0 : H_0 = Z/2 + Z, H_1 = Z
  let c3 = complex_new(0, [2, 2], [[[2, 0], [0, 0]]])
  let h3 = c3.homology()
  check(h3[0].betti == 1, "H6 one free summand in H_0")
  check(h3[0].torsion.length() == 1 && h3[0].torsion[0] == 2, "H6 torsion Z/2")
  check(h3[1].betti == 1, "H6 H_1 = Z")
  check(c3.euler() == 0 && c3.homology_euler() == 0, "H6 chi = 0")
  // three-term complex with a zero second differential
  let c4 = complex_new(0, [1, 2, 1], [[[2, 0]], [[0], [0]]])
  let h4 = c4.homology()
  check(h4[2].betti == 1, "H6 H_2 = Z")
  check(h4[1].betti == 1, "H6 H_1 = Z")
  check(h4[0].betti == 0 && h4[0].torsion.length() == 1, "H6 H_0 = Z/2")
  check(c4.euler() == 0 && c4.homology_euler() == 0, "H6 chi(C) = chi(H)")
  // chi and Betti numbers are additive in split short exact sequences
  let ds = direct_sum(c2, c3)
  check(ds.euler() == c2.euler() + c3.euler(), "H6 chi additive")
  for i = 0; i < ds.ranks.length(); i = i + 1 {
    check(
      ds.homology()[i].betti == c2.homology()[i].betti + c3.homology()[i].betti,
      "H6 Betti additive at " + i.to_string(),
    )
    check(
      ds.homology()[i].torsion.length() ==
        c2.homology()[i].torsion.length() + c3.homology()[i].torsion.length(),
      "H6 torsion additive at " + i.to_string(),
    )
  }
  check(ds.torsion_order() == c2.torsion_order() * c3.torsion_order(), "H6 |torsion| multiplicative")
}

test "Smith normal form invariant factors: known matrices" {
  check(vec_eq(@linalg.snf([[2, 0], [0, 3]]), [1, 6]), "snf diag(2,3) = diag(1,6)")
  check(vec_eq(@linalg.snf([[4, 0], [0, 6]]), [2, 12]), "snf diag(4,6) = diag(2,12)")
  check(vec_eq(@linalg.snf([[2, 4], [6, 8]]), [2, 4]), "snf of a 2x2 matrix")
  let sz = @linalg.snf([[0, 0], [0, 5]])
  let mut zeros = 0
  let nz : Array[Int] = []
  for i = 0; i < sz.length(); i = i + 1 {
    if sz[i] == 0 {
      zeros = zeros + 1
    } else {
      nz.push(sz[i])
    }
  }
  check(zeros == 1 && vec_eq(nz, [5]), "snf with a zero row")
  check(@linalg.rank_z([[2, 4], [6, 8]]) == 2, "rank over Z")
  check(@linalg.rank_z([[1, 2], [2, 4]]) == 1, "rank over Z of a singular matrix")
}

fn vec_eq(a : Array[Int], b : Array[Int]) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if a[i] != b[i] {
      return false
    }
  }
  true
}
