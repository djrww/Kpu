// ===========================================================================
//  padic — the ring of p-adic integers Z_p, truncated to finite precision
//  (「p進整數環」, structure 7).
//
//  Definition.  Z_p = lim_k Z/p^k is represented by its digit expansion
//      x = sum_{i=0}^{prec-1} d_i p^i,   0 <= d_i < p,
//  i.e. by the coherent system of residues x mod p^k.  Truncation
//  `trunc(k) : Z/p^prec -> Z/p^k` is the projection of the inverse limit.
//
//  Theorems (verified exhaustively in `padic_wbtest`):
//   P1 (Z_p, +, *) is a commutative ring with 1; truncation is a ring
//      homomorphism, i.e. the inverse system is coherent.
//   P2 v(x*y) = v(x) + v(y) and v(x+y) >= min(v(x),v(y)), with equality when
//      v(x) != v(y): Z_p is a discrete valuation ring.
//   P3 Ostrowski: |x|_p = p^{-v(x)} is a non-archimedean absolute value,
//      |x+y|_p <= max(|x|_p, |y|_p), equality if |x|_p != |y|_p.
//   P4 every ideal of Z_p is (p^k): the ideal generated by finitely many
//      elements is generated by one of minimal valuation, and every element is
//      divisible by it.
//   P5 (A40 Teichmuller) for a in F_p^* the limit w(a) = lim_n a^{p^n} exists,
//      satisfies w(a)^{p-1} = 1, w(a) = a mod p, w(ab) = w(a)w(b), and every
//      unit factors uniquely as w(a) * (1 + p*z):  Z_p^* = mu_{p-1} x (1+pZ_p).
//   P6 (A39 Hensel) if f(r) = 0 mod p and f'(r) != 0 mod p then there is a
//      unique root R of f in Z_p with R = r mod p, computed by Newton iteration
//      to every precision.
//   P7 (A41) exp and log converge on v(x) >= 1 (p >= 3) and are mutually
//      inverse; log is a homomorphism from 1+pZ_p to (Z_p, +) and exp its
//      inverse, exp(a+b) = exp(a)exp(b).
//   P8 (Newton polygon) the slopes of the lower convex hull of {(i, v(a_i))}
//      are exactly the negatives of the valuations of the roots.
// ===========================================================================

///| A p-adic integer truncated to `prec` digits in base p.
pub struct Padic {
  p : Int
  prec : Int
  digits : Array[Int]
}

fn mk(p : Int, prec : Int, ds : Array[Int]) -> Padic {
  let out : Array[Int] = Array::make(prec, 0)
  let mut carry = 0
  for i = 0; i < prec; i = i + 1 {
    let v = (if i < ds.length() {
      ds[i]
    } else {
      0
    }) + carry
    out[i] = @kernel.modpos(v, p)
    carry = (v - out[i]) / p
  }
  { p, prec, digits: out }
}

///| The p-adic integer congruent to the ordinary integer `x`.
pub fn padic_of_int(p : Int, prec : Int, x : Int) -> Padic {
  let ds : Array[Int] = []
  let mut rest = @kernel.modpos(x, @arith.pow_int(p, prec))
  for _i = 0; _i < prec; _i = _i + 1 {
    ds.push(rest % p)
    rest = rest / p
  }
  mk(p, prec, ds)
}

pub fn padic_zero(p : Int, prec : Int) -> Padic {
  mk(p, prec, [])
}

pub fn padic_one(p : Int, prec : Int) -> Padic {
  padic_of_int(p, prec, 1)
}

///| The uniformiser p itself.
pub fn padic_gen(p : Int, prec : Int) -> Padic {
  mk(p, prec, [0, 1])
}

pub fn Padic::to_int(self : Padic) -> Int {
  let mut acc = 0
  let mut pw = 1
  for i = 0; i < self.prec; i = i + 1 {
    acc = acc + self.digits[i] * pw
    pw = pw * self.p
  }
  acc
}

pub fn Padic::to_string(self : Padic) -> String {
  let parts : Array[String] = []
  for i = self.prec - 1; i >= 0; i = i - 1 {
    parts.push(self.digits[i].to_string())
  }
  parts.join("") + "_p" + self.prec.to_string()
}

pub fn Padic::equal(self : Padic, other : Padic) -> Bool {
  if self.p != other.p {
    return false
  }
  let k = Int::min(self.prec, other.prec)
  for i = 0; i < k; i = i + 1 {
    if self.digits[i] != other.digits[i] {
      return false
    }
  }
  true
}

pub fn Padic::add(self : Padic, other : Padic) -> Padic {
  let ds : Array[Int] = []
  for i = 0; i < self.prec; i = i + 1 {
    ds.push(self.digits[i] + other.digits[i])
  }
  mk(self.p, self.prec, ds)
}

pub fn Padic::neg(self : Padic) -> Padic {
  let ds : Array[Int] = []
  for i = 0; i < self.prec; i = i + 1 {
    ds.push(-self.digits[i])
  }
  mk(self.p, self.prec, ds)
}

pub fn Padic::sub(self : Padic, other : Padic) -> Padic {
  self.add(other.neg())
}

pub fn Padic::mul(self : Padic, other : Padic) -> Padic {
  let ds : Array[Int] = Array::make(self.prec, 0)
  for i = 0; i < self.prec; i = i + 1 {
    for j = 0; j < self.prec; j = j + 1 {
      if i + j < self.prec {
        ds[i + j] = ds[i + j] + self.digits[i] * other.digits[j]
      }
    }
  }
  mk(self.p, self.prec, ds)
}

///| Truncation to fewer digits: the projection Z/p^prec -> Z/p^k.
pub fn Padic::trunc(self : Padic, k : Int) -> Padic {
  let kk = Int::min(k, self.prec)
  let ds : Array[Int] = []
  for i = 0; i < kk; i = i + 1 {
    ds.push(self.digits[i])
  }
  mk(self.p, kk, ds)
}

///| Extend to more digits (zeros): the section used for coherence checks.
pub fn Padic::padic_extend(self : Padic, k : Int) -> Padic {
  if k <= self.prec {
    return self.trunc(k)
  }
  let ds : Array[Int] = []
  for i = 0; i < k; i = i + 1 {
    ds.push(if i < self.prec {
      self.digits[i]
    } else {
      0
    })
  }
  mk(self.p, k, ds)
}

///| p-adic valuation: the index of the first nonzero digit (`prec` for zero).
pub fn Padic::val(self : Padic) -> Int {
  for i = 0; i < self.prec; i = i + 1 {
    if self.digits[i] != 0 {
      return i
    }
  }
  self.prec
}

pub fn Padic::is_zero(self : Padic) -> Bool {
  self.val() >= self.prec
}

pub fn Padic::is_unit(self : Padic) -> Bool {
  self.digits[0] != 0
}

///| Exact division by p^k (only valid when v(self) >= k).
pub fn Padic::div_p(self : Padic, k : Int) -> Padic {
  if self.val() < k && !(self.is_zero()) {
    abort("[padic.div_p] not divisible by p^" + k.to_string())
  }
  let ds : Array[Int] = Array::make(self.prec, 0)
  for i = 0; i + k < self.prec; i = i + 1 {
    ds[i] = self.digits[i + k]
  }
  mk(self.p, self.prec, ds)
}

///| **A63 Newton inverse** of a unit, by Newton iteration x <- x*(2 - a*x) doubling the
///| precision at every step.
pub fn Padic::inv(self : Padic) -> Padic {
  if !(self.is_unit()) {
    abort("[padic.inv] not a unit")
  }
  let p = self.p
  // start with the inverse mod p (Fermat)
  let a0 = self.digits[0]
  let mut x = padic_of_int(p, self.prec, @arith.invmod_fermat(a0, p))
  let mut known = 1
  while known < self.prec {
    // x <- x*(2 - a*x) is correct mod p^(2*known)
    let two = padic_of_int(p, self.prec, 2)
    let prod = self.mul(x)
    let diff = two.sub(prod)
    x = x.mul(diff)
    known = known * 2
  }
  x
}

pub fn Padic::div(self : Padic, other : Padic) -> Padic {
  self.mul(other.inv())
}

///| Power by binary exponentiation.
pub fn Padic::pow(self : Padic, e : Int) -> Padic {
  let mut acc = padic_one(self.p, self.prec)
  let mut base = self
  let mut n = e
  while n > 0 {
    if n % 2 == 1 {
      acc = acc.mul(base)
    }
    base = base.mul(base)
    n = n / 2
  }
  acc
}

// ---------------------------------------------------------------------------
//  P5  Teichmuller representatives
// ---------------------------------------------------------------------------

///| **A64 Teichmuller lift**: w(a) = lim_n a^{p^n}, the unique (p-1)-st root of
///| unity congruent to a mod p.
pub fn teichmuller(p : Int, prec : Int, a : Int) -> Padic {
  let a0 = @kernel.modpos(a, p)
  if a0 == 0 {
    return padic_zero(p, prec)
  }
  let mut x = padic_of_int(p, prec, a0)
  for _i = 0; _i < prec + 2; _i = _i + 1 {
    x = x.pow(p)
  }
  x
}

///| The multiplicative decomposition of a unit: x = w(a) * (1 + p*z), returned
///| as (Teichmuller part, z).
pub fn Padic::teich_split(self : Padic) -> (Padic, Padic) {
  let w = teichmuller(self.p, self.prec, self.digits[0])
  let rest = self.div(w)
  // rest = 1 + p*z  =>  z = (rest - 1)/p
  let one = padic_one(self.p, self.prec)
  let z = rest.sub(one).div_p(1)
  (w, z)
}

// ---------------------------------------------------------------------------
//  P6  Hensel lifting
// ---------------------------------------------------------------------------

///| Evaluate a polynomial with p-adic coefficients (ascending order).
pub fn poly_eval_padic(coeffs : Array[Padic], x : Padic) -> Padic {
  let mut acc = padic_zero(x.p, x.prec)
  for i = coeffs.length() - 1; i >= 0; i = i - 1 {
    acc = acc.mul(x).add(coeffs[i])
  }
  acc
}

///| Formal derivative.
pub fn poly_deriv_padic(coeffs : Array[Padic]) -> Array[Padic] {
  let out : Array[Padic] = []
  for i = 1; i < coeffs.length(); i = i + 1 {
    let c = coeffs[i]
    let ds : Array[Int] = Array::make(c.prec, 0)
    let mut carry = 0
    for j = 0; j < c.prec; j = j + 1 {
      let v = c.digits[j] * i + carry
      ds[j] = @kernel.modpos(v, c.p)
      carry = (v - ds[j]) / c.p
    }
    out.push(mk(c.p, c.prec, ds))
  }
  if out.is_empty() {
    out.push(padic_zero(coeffs[0].p, coeffs[0].prec))
  }
  out
}

///| **A65 Hensel lifting**: lift a simple root `r0` of `f` mod p to a root of
///| `f` in Z_p to precision `prec`, by Newton iteration.
pub fn hensel_lift(
  coeffs_mod : Array[Int],
  r0 : Int,
  p : Int,
  prec : Int,
) -> Padic {
  let coeffs : Array[Padic] = []
  for i = 0; i < coeffs_mod.length(); i = i + 1 {
    coeffs.push(padic_of_int(p, prec, coeffs_mod[i]))
  }
  let d = poly_deriv_padic(coeffs)
  let mut x = padic_of_int(p, prec, r0)
  for _i = 0; _i < prec + 2; _i = _i + 1 {
    let fx = poly_eval_padic(coeffs, x)
    let dfx = poly_eval_padic(d, x)
    if dfx.is_zero() {
      abort("[padic.hensel_lift] f'(r) = 0: the root is not simple")
    }
    x = x.sub(fx.div(dfx))
  }
  x
}

// ---------------------------------------------------------------------------
//  P7  p-adic exponential and logarithm
// ---------------------------------------------------------------------------

///| v_p(n!) by Legendre's formula (no overflow: n! is never formed).
fn v_fact(p : Int, n : Int) -> Int {
  let mut acc = 0
  let mut q = n / p
  while q > 0 {
    acc = acc + q
    q = q / p
  }
  acc
}

///| **A66 p-adic exponential** exp(x) = sum x^n/n!, convergent for v(x) >= 1
///| and p >= 3.  The terms are built recursively, t_n = t_{n-1} * x / n, where
///| the division by n = p^e * u is exact (v(t_{n-1} x) >= e because
///| v_p(n!) <= n) followed by multiplication with the inverse of the unit u.
///| Each exact division by p costs one digit of precision, so the series is
///| evaluated at a working precision prec + v_p(maxn!) + 3 and truncated back.
pub fn padic_exp(x : Padic) -> Padic {
  if x.p < 3 {
    abort("[padic_exp] needs p >= 3 for convergence at v(x) >= 1")
  }
  if x.val() < 1 && !(x.is_zero()) {
    abort("[padic_exp] needs v(x) >= 1")
  }
  let p = x.p
  let prec = x.prec
  let maxn = 6 * prec + 20
  let wp = prec + v_fact(p, maxn) + 3
  let xw = x.padic_extend(wp)
  let mut term = padic_one(p, wp)
  let mut acc = term
  let mut n = 1
  let v = x.val()
  while n <= maxn {
    if n * v - v_fact(p, n) >= wp {
      break
    }
    let e = @arith.valuation(n, p)
    let u = n / @arith.pow_int(p, e)
    term = term.mul(xw).div_p(e).mul(padic_of_int(p, wp, u).inv())
    acc = acc.add(term)
    n = n + 1
  }
  acc.trunc(prec)
}

///| **A66 (cont.) p-adic logarithm** log(1+u) = sum_{n>=1} (-1)^{n+1} u^n / n, built
///| recursively the same way, again at a padded working precision.
pub fn padic_log(u : Padic) -> Padic {
  if u.p < 3 {
    abort("[padic_log] needs p >= 3")
  }
  if u.val() < 1 && !(u.is_zero()) {
    abort("[padic_log] needs v(u) >= 1")
  }
  let p = u.p
  let prec = u.prec
  let maxn = 6 * prec + 20
  let wp = prec + v_fact(p, maxn) + 3
  let uw = u.padic_extend(wp)
  let mut acc = padic_zero(p, wp)
  let mut term = uw // term_n = u^n / n, built recursively below
  let mut n = 1
  let v = u.val()
  while n <= maxn {
    if n * v - @arith.valuation(n, p) >= wp {
      break
    }
    if n == 1 {
      term = uw
    } else {
      // term_n = term_{n-1} * u * (n-1) / n ; the division by p^e is exact
      // because v(term_{n-1} * u * (n-1)) = n*v(u) >= v_p(n).
      let e = @arith.valuation(n, p)
      let unit = n / @arith.pow_int(p, e)
      term = term.mul(uw).mul(padic_of_int(p, wp, n - 1)).div_p(e).mul(
        padic_of_int(p, wp, unit).inv(),
      )
    }
    acc = if n % 2 == 1 {
      acc.add(term)
    } else {
      acc.sub(term)
    }
    n = n + 1
  }
  acc.trunc(prec)
}

///| log on the multiplicative group 1 + pZ_p, given the element itself.
pub fn padic_log1p(x : Padic) -> Padic {
  padic_log(x.sub(padic_one(x.p, x.prec)))
}

// ---------------------------------------------------------------------------
//  P8  Newton polygon
// ---------------------------------------------------------------------------

///| **A67 Newton polygon**: lower convex hull of {(i, v(a_i))}: returns the vertex indices in order.
pub fn newton_polygon(vals : Array[Int], big : Int) -> Array[Int] {
  let pts : Array[Array[Int]] = []
  for i = 0; i < vals.length(); i = i + 1 {
    if vals[i] < big {
      pts.push([i, vals[i]])
    }
  }
  let hull : Array[Array[Int]] = []
  for i = 0; i < pts.length(); i = i + 1 {
    while hull.length() >= 2 {
      let a = hull[hull.length() - 2]
      let b = hull[hull.length() - 1]
      let c = pts[i]
      let cr = (b[0] - a[0]) * (c[1] - a[1]) - (b[1] - a[1]) * (c[0] - a[0])
      if cr <= 0 {
        ignore(hull.pop())
      } else {
        break
      }
    }
    hull.push(pts[i])
  }
  let idx : Array[Int] = []
  for i = 0; i < hull.length(); i = i + 1 {
    idx.push(hull[i][0])
  }
  idx
}

///| Slopes of the Newton polygon, as (rise, run) pairs; each slope -run/rise
///| contributes `run` roots of that valuation.
pub fn newton_slopes(coeffs : Array[Padic]) -> Array[(Int, Int)] {
  let vals : Array[Int] = []
  for i = 0; i < coeffs.length(); i = i + 1 {
    vals.push(coeffs[i].val())
  }
  let hull = newton_polygon(vals, coeffs[0].prec)
  let out : Array[(Int, Int)] = []
  for i = 1; i < hull.length(); i = i + 1 {
    let dx = hull[i] - hull[i - 1]
    let dy = vals[hull[i]] - vals[hull[i - 1]]
    out.push((dy, dx))
  }
  out
}

///| Predicted root valuations from the Newton polygon, as reduced triples
///| (numerator, denominator, multiplicity): a segment of slope dy/dx contributes
///| `dx` roots of valuation -dy/dx.  The denominator is 1 exactly when those
///| roots already lie in Q_p (unramified for that slope).
pub fn newton_root_valuations(coeffs : Array[Padic]) -> Array[(Int, Int, Int)] {
  let sl = newton_slopes(coeffs)
  let out : Array[(Int, Int, Int)] = []
  for i = 0; i < sl.length(); i = i + 1 {
    let (dy, dx) = sl[i]
    let g = @arith.gcd(Int::abs(dy), dx)
    let gg = if g == 0 {
      1
    } else {
      g
    }
    out.push((-dy / gg, dx / gg, dx))
  }
  out.sort_by(fn(a, b) { a.0 * b.1 - b.0 * a.1 })
  out
}
