// ===========================================================================
//  義務自證 · P1–P8 for the p-adic integers.  The ring axioms, valuation laws,
//  Teichmuller decomposition, Hensel lifting (including uniqueness), the
//  exp/log isomorphism and the Newton polygon are all checked by *complete*
//  enumeration of the finite rings Z/p^k.
// ===========================================================================

fn check(cond : Bool, msg : String) -> Unit {
  if cond {
    ()
  } else {
    println("CHECK FAILED: " + msg)
    abort("[padic law failed] " + msg)
  }
}

///| Every element of Z/p^prec.
fn all_padics(p : Int, prec : Int) -> Array[Padic] {
  let n = @arith.pow_int(p, prec)
  let out : Array[Padic] = []
  for i = 0; i < n; i = i + 1 {
    out.push(padic_of_int(p, prec, i))
  }
  out
}

test "P1 Z/p^k is a commutative ring and truncation is a ring homomorphism" {
  for p in [3, 5] {
    let prec = 3
    let els = all_padics(p, prec)
    let zero = padic_zero(p, prec)
    let one = padic_one(p, prec)
    for i = 0; i < els.length(); i = i + 1 {
      let a = els[i]
      check(a.add(zero).equal(a), "additive identity")
      check(a.mul(one).equal(a), "multiplicative identity")
      check(a.add(a.neg()).equal(zero), "additive inverse")
      for j = 0; j < els.length(); j = j + 1 {
        let b = els[j]
        check(a.add(b).equal(b.add(a)), "addition commutative")
        check(a.mul(b).equal(b.mul(a)), "multiplication commutative")
        // truncation is a ring homomorphism
        check(
          a.add(b).trunc(2).equal(a.trunc(2).add(b.trunc(2))),
          "truncation additive",
        )
        check(
          a.mul(b).trunc(2).equal(a.trunc(2).mul(b.trunc(2))),
          "truncation multiplicative",
        )
        check(
          a.trunc(1).equal(a.trunc(2).trunc(1)),
          "truncations are coherent (inverse system)",
        )
        for t = 0; t < els.length(); t = t + 1 {
          let c = els[t]
          check(a.add(b).add(c).equal(a.add(b.add(c))), "addition associative")
          check(a.mul(b).mul(c).equal(a.mul(b.mul(c))), "multiplication associative")
          check(
            a.mul(b.add(c)).equal(a.mul(b).add(a.mul(c))),
            "distributivity",
          )
        }
      }
    }
  }
}

test "P2/P3 valuation: v(xy) = v(x)+v(y), v(x+y) >= min, Ostrowski ultrametric" {
  let p = 3
  let prec = 4
  let els = all_padics(p, prec)
  for i = 0; i < els.length(); i = i + 1 {
    let x = els[i]
    for j = 0; j < els.length(); j = j + 1 {
      let y = els[j]
      let vx = x.val()
      let vy = y.val()
      let vp = x.mul(y).val()
      if vx + vy < prec {
        check(vp == vx + vy, "P2 v(xy) = v(x)+v(y)")
      } else {
        check(vp >= prec, "product vanishes at this precision")
      }
      let vs = x.add(y).val()
      check(vs >= Int::min(vx, vy), "P2 v(x+y) >= min")
      if vx != vy {
        check(vs == Int::min(vx, vy), "P3 strict ultrametric equality")
      }
      // |.|_p = p^{-v}: the ultrametric inequality in absolute-value form
      let nx = @arith.pow_int(p, prec - Int::min(vx, prec))
      let ny = @arith.pow_int(p, prec - Int::min(vy, prec))
      let ns = @arith.pow_int(p, prec - Int::min(vs, prec))
      check(ns <= Int::max(nx, ny), "P3 Ostrowski triangle inequality")
      // units and divisibility
      if x.is_unit() {
        check(vx == 0, "unit has valuation 0")
        check(x.mul(x.inv()).equal(padic_one(p, prec)), "unit inverse")
      }
    }
  }
}

test "P4 Z_p is a DVR: the ideal generated by finitely many elements is (p^min v)" {
  let p = 5
  let prec = 4
  let els = all_padics(p, prec)
  for i = 0; i < els.length(); i = i + 1 {
    for j = 0; j < els.length(); j = j + 1 {
      let x = els[i]
      let y = els[j]
      let m = Int::min(x.val(), y.val())
      if m >= prec {
        continue
      }
      // both elements are divisible by p^m ...
      check(x.div_p(m).to_int() >= 0, "x divisible by p^m")
      check(y.div_p(m).to_int() >= 0, "y divisible by p^m")
      // ... and p^m itself is a combination: it is the smaller-valuation one,
      // divided by its unit part
      let g = if x.val() <= y.val() {
        x
      } else {
        y
      }
      let unit = g.div_p(m)
      check(unit.is_unit(), "x/p^v(x) is a unit")
      let pm = g.div(unit)
      check(pm.val() == m, "p^m is in the ideal")
      check(
        pm.equal(padic_gen(p, prec).pow(m)),
        "the generator really is p^m",
      )
      // x and y lie in (p^m)
      check(x.div_p(m).mul(pm).equal(x), "x in (p^m)")
      check(y.div_p(m).mul(pm).equal(y), "y in (p^m)")
    }
  }
}

test "P5 Teichmuller: w(a)^{p-1}=1, w(a)=a mod p, w(ab)=w(a)w(b), and units split" {
  for p in [3, 5] {
    let prec = 4
    let one = padic_one(p, prec)
    for a = 1; a < p; a = a + 1 {
      let w = teichmuller(p, prec, a)
      check(w.pow(p - 1).equal(one), "P5 root of unity")
      check(w.digits[0] == a, "P5 congruent to a mod p")
      check(w.pow(p).equal(w), "P5 fixed by Frobenius")
      for b = 1; b < p; b = b + 1 {
        let wb = teichmuller(p, prec, b)
        check(
          w.mul(wb).equal(teichmuller(p, prec, (a * b) % p)),
          "P5 multiplicativity",
        )
      }
    }
    // unique factorisation of every unit: u = w(a) * (1 + p z)
    let els = all_padics(p, prec)
    for i = 0; i < els.length(); i = i + 1 {
      let u = els[i]
      if !(u.is_unit()) {
        continue
      }
      let (w, z) = u.teich_split()
      let one_plus = one.add(padic_gen(p, prec).mul(z))
      check(w.mul(one_plus).equal(u), "P5 unit decomposition")
      check(w.pow(p - 1).equal(one), "P5 Teichmuller part is a root of unity")
      check(w.digits[0] == u.digits[0], "P5 same residue")
    }
  }
}

///| Evaluate an integer polynomial (ascending coefficients) at r mod p^prec.
fn eval_int(coeffs : Array[Int], r : Int, p : Int, prec : Int) -> Int {
  let m = @arith.pow_int(p, prec)
  let mut acc = 0
  for i = coeffs.length() - 1; i >= 0; i = i - 1 {
    acc = @kernel.modpos(acc * r + coeffs[i], m)
  }
  acc
}

test "P6 Hensel: simple roots mod p lift uniquely to roots in Z/p^k" {
  for p in [3, 5] {
    let prec = 4
    let m = @arith.pow_int(p, prec)
    // every monic polynomial of degree 2 and 3 over F_p
    for deg in [2, 3] {
      let total = @arith.pow_int(p, deg)
      for c = 0; c < total; c = c + 1 {
        let ds = @arith.digits(c, p)
        let coeffs : Array[Int] = []
        for i = 0; i < deg; i = i + 1 {
          coeffs.push(if i < ds.length() {
            ds[i]
          } else {
            0
          })
        }
        coeffs.push(1) // monic
        // simple roots mod p
        for r0 = 0; r0 < p; r0 = r0 + 1 {
          if eval_int(coeffs, r0, p, 1) != 0 {
            continue
          }
          // f'(r0) mod p != 0
          let mut d = 0
          for i = 1; i < coeffs.length(); i = i + 1 {
            d = @kernel.modpos(d + i * coeffs[i] * pow_small(r0, i - 1, p), p)
          }
          if d == 0 {
            continue
          }
          let r = hensel_lift(coeffs, r0, p, prec)
          check(r.digits[0] == r0, "P6 the lift reduces to r0")
          check(
            eval_int(coeffs, r.to_int(), p, prec) == 0,
            "P6 f(r) = 0 mod p^k, p=" + p.to_string(),
          )
          // uniqueness: no other residue mod p^k reduces to r0 and is a root
          for cand = 0; cand < m; cand = cand + 1 {
            if cand % p != r0 {
              continue
            }
            if eval_int(coeffs, cand, p, prec) == 0 {
              check(cand == r.to_int(), "P6 uniqueness of the Hensel lift")
            }
          }
        }
      }
    }
  }
}

fn pow_small(b : Int, e : Int, p : Int) -> Int {
  let mut acc = 1
  for _i = 0; _i < e; _i = _i + 1 {
    acc = @kernel.modpos(acc * b, p)
  }
  acc
}

test "P7 exp and log are mutually inverse homomorphisms on the maximal ideal" {
  let p = 3
  let prec = 4
  let els = all_padics(p, prec)
  // the maximal ideal p*Z_p
  let max : Array[Padic] = []
  for i = 0; i < els.length(); i = i + 1 {
    if els[i].val() >= 1 || els[i].is_zero() {
      max.push(els[i])
    }
  }
  check(max.length() == @arith.pow_int(p, prec - 1), "size of p*Z_p")
  let one = padic_one(p, prec)
  for i = 0; i < max.length(); i = i + 1 {
    let x = max[i]
    let ex = padic_exp(x)
    check(
      padic_log(ex.sub(one)).equal(x),
      "P7 log(exp(x)) = x, x=" + x.to_int().to_string() + " ex=" + ex.to_int().to_string() +
        " got=" + padic_log(ex.sub(one)).to_int().to_string(),
    )
    check(
      padic_exp(padic_log1p(ex)).equal(ex),
      "P7 exp(log(y)) = y, y=" + ex.to_int().to_string() +
        " got=" + padic_exp(padic_log1p(ex)).to_int().to_string(),
    )
    check(ex.is_unit(), "exp lands in the units")
    for j = 0; j < max.length(); j = j + 1 {
      let y = max[j]
      check(
        padic_exp(x.add(y)).equal(padic_exp(x).mul(padic_exp(y))),
        "P7 exp(a+b) = exp(a)exp(b)",
      )
      check(
        padic_log1p(one.add(x).mul(one.add(y))).equal(
          padic_log1p(one.add(x)).add(padic_log1p(one.add(y))),
        ),
        "P7 log is a homomorphism 1+pZ_p -> (Z_p,+)",
      )
    }
  }
}

test "P8 Newton polygon: slopes give the root valuations and span the degree" {
  let p = 3
  let prec = 6
  // polynomials that split over Z_p, built from their roots
  let root_sets : Array[Array[Int]] = [
    [1, p],
    [p, p * p],
    [2, 1 + p, p * p * p],
    [p, p, p],
    [1, 2, p * p, 1 + p],
  ]
  for s = 0; s < root_sets.length(); s = s + 1 {
    let rs = root_sets[s]
    // f = prod (x - r_i) with p-adic coefficients
    let mut coeffs : Array[Padic] = [padic_one(p, prec)]
    for i = 0; i < rs.length(); i = i + 1 {
      let r = padic_of_int(p, prec, rs[i])
      let nxt : Array[Padic] = []
      for k = 0; k <= coeffs.length(); k = k + 1 {
        let lo = if k < coeffs.length() {
          coeffs[k]
        } else {
          padic_zero(p, prec)
        }
        let hi = if k - 1 >= 0 && k - 1 < coeffs.length() {
          coeffs[k - 1]
        } else {
          padic_zero(p, prec)
        }
        nxt.push(hi.sub(lo.mul(r)))
      }
      coeffs = nxt
    }
    let predicted = newton_root_valuations(coeffs)
    // actual valuations of the roots, computed from the roots themselves and
    // grouped into (valuation, multiplicity) pairs
    let vals : Array[Int] = []
    let mults : Array[Int] = []
    for i = 0; i < rs.length(); i = i + 1 {
      let r = padic_of_int(p, prec, rs[i])
      let v = r.val()
      if v >= prec {
        continue
      }
      let mut found = false
      for t = 0; t < vals.length(); t = t + 1 {
        if vals[t] == v {
          mults[t] = mults[t] + 1
          found = true
        }
      }
      if !(found) {
        vals.push(v)
        mults.push(1)
      }
    }
    let actual : Array[(Int, Int, Int)] = []
    for t = 0; t < vals.length(); t = t + 1 {
      actual.push((vals[t], 1, mults[t]))
    }
    actual.sort_by(fn(a, b) { a.0 * b.1 - b.0 * a.1 })
    check(
      predicted.length() == actual.length() &&
        triple_vec_eq(predicted, actual),
      "P8 root valuations, case " +
        s.to_string() +
        " got " +
        fmt_triples(predicted) +
        " want " +
        fmt_triples(actual),
    )
    // every slope is integral for a polynomial that splits over Z_p
    for i = 0; i < predicted.length(); i = i + 1 {
      check(predicted[i].1 == 1, "P8 split polynomial has integral slopes")
    }
    // the slopes always span the degree and account for v(a_0) - v(a_n)
    let sl = newton_slopes(coeffs)
    let mut run = 0
    let mut rise = 0
    for i = 0; i < sl.length(); i = i + 1 {
      run = run + sl[i].1
      rise = rise + sl[i].0
    }
    check(run == coeffs.length() - 1, "P8 total run = degree")
    let v0 = coeffs[0].val()
    let vn = coeffs[coeffs.length() - 1].val()
    check(rise == vn - v0, "P8 total rise = v(a_n) - v(a_0)")
  }
  // a polynomial that does not split: x^2 - p has a single segment of slope 1/2
  let coeffs : Array[Padic] = [
    padic_of_int(p, prec, -p),
    padic_zero(p, prec),
    padic_one(p, prec),
  ]
  let sl = newton_slopes(coeffs)
  check(sl.length() == 1, "one segment for x^2 - p")
  check(sl[0].0 == -1 && sl[0].1 == 2, "slope -1/2, ramified")
}

fn fmt_triples(xs : Array[(Int, Int, Int)]) -> String {
  let parts : Array[String] = []
  for i = 0; i < xs.length(); i = i + 1 {
    parts.push(
      "(" + xs[i].0.to_string() + "/" + xs[i].1.to_string() + " x" + xs[i].2.to_string() + ")",
    )
  }
  "[" + parts.join(", ") + "]"
}

fn triple_vec_eq(
  a : Array[(Int, Int, Int)],
  b : Array[(Int, Int, Int)],
) -> Bool {
  if a.length() != b.length() {
    return false
  }
  for i = 0; i < a.length(); i = i + 1 {
    if a[i].0 != b[i].0 || a[i].1 != b[i].1 || a[i].2 != b[i].2 {
      return false
    }
  }
  true
}
